{
  "manifest_version": 3,
  "name": "uDownloader",
  "version": "0.1.0",
  "description": "Detect and download page videos (direct files, HLS, DASH) locally. No external services.",
  "permissions": ["webRequest", "declarativeNetRequest", "downloads", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "uDownloader"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "incognito": "split"
}
