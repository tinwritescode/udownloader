{
  "manifest_version": 3,
  "name": "uDownloader",
  "version": "0.1.0",
  "description": "Detect and download page videos (direct files, HLS, DASH) locally. No external services.",
  "homepage_url": "https://github.com/tinwritescode/udownloader",
  "minimum_chrome_version": "102",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["webRequest", "declarativeNetRequest", "downloads", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
    "default_title": "uDownloader"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "incognito": "split"
}
